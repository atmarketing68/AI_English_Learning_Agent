# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env && nano .env
# File .env chứa khoá bí mật — KHÔNG đưa lên GitHub.

# ── Cơ sở dữ liệu (container db) ──
POSTGRES_DB=agen_production
POSTGRES_USER=agen
POSTGRES_PASSWORD=ĐỔI_THÀNH_MẬT_KHẨU_MẠNH

# ── Cách mở API ra internet: chọn MỘT trong hai ──
CLOUDFLARE_TUNNEL_TOKEN=          # cách 1 (profile tunnel): token tạo trong Cloudflare Zero Trust → Tunnels
API_DOMAIN=                       # cách 2 (profile caddy): vd. api.aiagentenglish.com

# ── Cấu hình ứng dụng (lấy giá trị từ render-env.txt của bản sao lưu) ──
APP_ENV=production
APP_NAME=AI English Learning Agent
APP_VERSION=1.0.0
APP_URL=https://aiagentenglish.com
ALLOWED_ORIGINS=https://aiagentenglish.com,https://www.aiagentenglish.com
ADMIN_EMAILS=
SECRET_KEY=                       # giữ NGUYÊN giá trị cũ để người dùng không bị đăng xuất
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=
OPENAI_API_KEY=
REMINDER_CRON_SECRET=             # GitHub Secrets REMINDER_CRON_SECRET phải trùng giá trị này
WORKERS=1
