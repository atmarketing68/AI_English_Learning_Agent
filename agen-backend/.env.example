# ============================================================
#  AGEN Backend — Environment Configuration Template
#  Copy to .env and fill in real values before running.
# ============================================================

# ── App ───────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_NAME="AGEN API"
APP_VERSION="1.0.0"

# ── Security ──────────────────────────────────────────────
# REQUIRED: generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────
# SQLite (dev/test only):
DATABASE_URL=sqlite:///./agen_dev.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/agen_db

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Production example:
# ALLOWED_ORIGINS=https://agen.yourdomain.com,https://www.agen.yourdomain.com

# ── AI Services ───────────────────────────────────────────
# At least one key is required for AI features
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Distributed worker ───────────────────────────────────
# local uses FastAPI BackgroundTasks; distributed uses Celery + Redis.
WORKER_MODE=local
REDIS_URL=

# ── Admin ─────────────────────────────────────────────────
# Comma-separated emails granted access to the /admin quality dashboard.
# Empty = no admin access for anyone.
ADMIN_EMAILS=
